<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" throwConfigExceptions="true">
  <targets>
    <target xsi:type="File" name="audit" fileName="${basedir}/logs/agent-${shortdate}.log" encoding="utf-8" archiveAboveSize="10485760" maxArchiveFiles="60" maxArchiveDays="30" layout="${longdate}|${level}|${logger}|${message}" />
    <target xsi:type="Console" name="console" layout="${longdate}|${level}|${message}" />
  </targets>
  <rules>
    <logger name="IISManager.*" minlevel="Info" writeTo="audit,console" final="true" />
    <logger name="*" minlevel="Warn" writeTo="audit,console" />
  </rules>
</nlog>
