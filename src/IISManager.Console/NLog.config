<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <target xsi:type="File" name="events" fileName="${basedir}/logs/console.log"
            encoding="utf-8" archiveEvery="Day" archiveAboveSize="10485760" maxArchiveFiles="30" maxArchiveDays="30"
            archiveSuffixFormat="_{1:yyyyMMdd}_{0}" layout="${date:format=o} ${level:uppercase=true} ${message}" />
  </targets>
  <rules>
    <logger name="IISManager.Events" minlevel="Info" writeTo="events" />
  </rules>
</nlog>
